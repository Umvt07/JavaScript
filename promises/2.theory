chatgpt on fetch
// ================= PROMISES + FETCH + ASYNC AWAIT =================



// ================================================================
// 1. WHY PROMISES EXIST
// ================================================================

// JavaScript is single threaded.
// It executes one thing at a time.

// Some tasks take time:
// - API calls
// - database calls
// - timers
// - file reading

// JS does NOT want to block everything while waiting.

// So it uses PROMISES.


// Promise means:

// "I promise I will give result later."


// Promise has 3 states:

// 1. pending   -> work still happening
// 2. fulfilled -> success
// 3. rejected  -> failed




// ================================================================
// 2. BASIC PROMISE
// ================================================================

const promise1 = new Promise((resolve,reject)=>{

    // async work

    setTimeout(()=>{

        resolve("Task completed");

    },2000);

});


// Initially:
// Promise { <pending> }

// After 2 sec:
// Promise { 'Task completed' }





// ================================================================
// 3. resolve()
// ================================================================

// resolve() means SUCCESS

const promise2 = new Promise((resolve,reject)=>{

    resolve("Success");

});




// ================================================================
// 4. reject()
// ================================================================

// reject() means FAILURE

const promise3 = new Promise((resolve,reject)=>{

    reject("Something went wrong");

});





// ================================================================
// 5. .then()
// ================================================================

// .then() runs AFTER promise resolves.

promise1.then((data)=>{

    console.log(data);

});


// Output after 2 sec:
// Task completed




// ================================================================
// 6. IMPORTANT:
// .then() ALWAYS RETURNS A NEW PROMISE
// ================================================================

const arr = promise1.then((data)=>{

    return data;

});


// arr is NOT actual data.

// arr is another promise.

console.log(arr);


// Output initially:
// Promise { <pending> }




// ================================================================
// 7. WHY PENDING PRINTS
// ================================================================

// console.log runs immediately.

// But promise has not resolved yet.

// So JS prints:

// Promise { <pending> }



// After promise resolves internally,
// console.log DOES NOT run again automatically.





// ================================================================
// 8. CHAINING
// ================================================================

promise1
.then((data)=>{

    return data + " hello";

})
.then((newData)=>{

    console.log(newData);

});




// ================================================================
// 9. ASYNC
// ================================================================

// async makes function ALWAYS return a promise.

async function test(){

    return "adarsh";

}

console.log(test());


// Output:
// Promise { 'adarsh' }



// Internally:

// return Promise.resolve("adarsh")





// ================================================================
// 10. AWAIT
// ================================================================

// await waits for promise completion.

const p = new Promise((resolve,reject)=>{

    setTimeout(()=>{

        resolve("adarsh");

    },2000);

});


async function consumePromise(){

    const data = await p;

    console.log(data);

}

consumePromise();


// Output after 2 sec:
// adarsh





// ================================================================
// 11. WITHOUT AWAIT
// ================================================================

async function demo(){

    const data = p;

    console.log(data);

}

demo();


// Output:
// Promise { <pending> }




// ================================================================
// 12. FETCH
// ================================================================

// fetch() RETURNS A PROMISE.

// You DO NOT manually create promise here.

// Browser already creates promise internally.

fetch('https://jsonplaceholder.typicode.com/users');




// ================================================================
// 13. FETCH FLOW
// ================================================================

// fetch(url)

// Step 1:
// Browser starts network request

// Step 2:
// fetch IMMEDIATELY returns promise

// Step 3:
// Promise stays pending until server responds

// Step 4:
// Promise becomes fulfilled




// ================================================================
// 14. FETCH WITH AWAIT
// ================================================================

async function getUsers(){

    const response = await fetch(
        'https://jsonplaceholder.typicode.com/users'
    );

    console.log(response);

}

getUsers();




// ================================================================
// 15. response.json()
// ================================================================

// response.json() ALSO returns a promise.

// Because JSON parsing takes time.

async function getData(){

    const response = await fetch(
        'https://jsonplaceholder.typicode.com/users'
    );

    const data = await response.json();

    console.log(data);

}

getData();




// ================================================================
// 16. IMPORTANT INTERNAL FLOW
// ================================================================

// JS Engine
// ↓
// Call Stack
// ↓
// Web APIs
// ↓
// Promise
// ↓
// Microtask Queue
// ↓
// Event Loop
// ↓
// Back to Call Stack




// ================================================================
// 17. EVENT LOOP
// ================================================================

// Event loop checks:

// "Is call stack empty?"

// If yes:
// execute queued tasks.





// ================================================================
// 18. MICROTASK QUEUE
// ================================================================

// Promise callbacks (.then)
// and await continuations

// go into:

// Microtask Queue



// Microtasks have HIGHER priority
// than setTimeout callbacks.





// ================================================================
// 19. IMPORTANT EXAMPLE
// ================================================================

console.log("A");

setTimeout(()=>{

    console.log("B");

},0);

Promise.resolve().then(()=>{

    console.log("C");

});

console.log("D");



// Output:

// A
// D
// C
// B



// Because:

// Promise.then -> Microtask Queue
// setTimeout   -> Task Queue





// ================================================================
// 20. ASYNC-AWAIT INTERNALS
// ================================================================

// async-await is basically syntax sugar over promises.


// This:

async function hello(){

    const data = await fetch(url);

}


// is almost same as:

function hello(){

    return fetch(url)
    .then((data)=>{

    });

}




// ================================================================
// 21. HUGE IMPORTANT POINT
// ================================================================

// await DOES NOT block whole JavaScript.

// It ONLY pauses THAT async function.


// Other code still runs.
// UI still works.
// Clicks still work.





// ================================================================
// 22. GOLDEN RULES
// ================================================================

// Promise = future value

// resolve() = success

// reject() = failure

// .then() runs after success

// .then() ALWAYS returns new promise

// async makes function return promise

// await waits for promise completion

// fetch() returns promise

// response.json() also returns promise

// Promise callbacks go into Microtask Queue

// Microtasks execute before setTimeout